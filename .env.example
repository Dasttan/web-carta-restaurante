# Copia este archivo como `.env` y rellénalo. `.env` no se sube a ningún repositorio.

# Cuenta inicial: solo se usa la primera vez que arranca el servidor.
# En local se admite una contraseña sencilla; en producción debe ser segura.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Producción: dirección pública exacta, con https y sin barra final.
PUBLIC_ORIGIN=
# Cuántos proxies hay delante (Caddy o Nginx = 1). Sin proxy, 0.
TRUST_PROXY=0

# Puerto y carpeta de datos (base de datos, multimedia y copias). Debe ser un disco persistente.
PORT=4188
DATA_DIR=data

# Opcional
MAX_IMAGE_MB=15
MAX_VIDEO_MB=150
SESSION_HOURS=12
SESSION_IDLE_HOURS=2

# Dirección para la imagen al compartir (se usa al compilar).
VITE_SITE_URL=
