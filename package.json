{
  "name": "web-carta-restaurante",
  "version": "1.0.0",
  "description": "Web Carta para Restaurante (muestra) / Restaurant Web Menu",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.ts --dev",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx",
    "local": "node --disable-warning=ExperimentalWarning server/index.ts",
    "start": "node --disable-warning=ExperimentalWarning server/produccion.ts",
    "tipos": "tsc --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "clave": "node --disable-warning=ExperimentalWarning server/cli.ts clave",
    "copia": "node --disable-warning=ExperimentalWarning server/cli.ts copia",
    "restaurar": "node --disable-warning=ExperimentalWarning server/cli.ts restaurar",
    "iconos": "node scripts/iconos.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3",
    "sharp": "^0.35.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
